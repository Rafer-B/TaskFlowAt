TASKFLOW_ENV=development
DB_HOST=localhost
DB_PORT=5432
DB_NAME=taskflowdb_at
DB_USER=postgres
DB_PASSWORD=root
TASKFLOW_JWT_SECRET=
TASKFLOW_CORS_ORIGINS=
TASKFLOW_COOKIE_SECURE=false
TASKFLOW_COOKIE_SAMESITE=lax
TASKFLOW_COOKIE_DOMAIN=

# Optional: set both values to enable email 2FA with Resend.
# Use a sender address on a domain verified in your Resend account.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
TASKFLOW_UPLOADS_DIR=./uploads
TASKFLOW_TASK_ATTACHMENTS_DIR=./task_attachments
TASKFLOW_BACKUP_DIR=./backups
TASKFLOW_BACKUP_RETENTION_DAYS=14
